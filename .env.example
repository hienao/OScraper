APP_ENV=production
# Generate, for example: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
# Provide exactly 32 random bytes or a base64-encoded 32-byte value.
CREDENTIAL_ENCRYPTION_KEY=00000000000000000000000000000000
TZ=Asia/Shanghai
DB_DRIVER=sqlite
DATABASE_URL=
HOST_DATA_DIR=./runtime/data
HOST_CACHE_DIR=./runtime/cache
SCRAPE_WORKERS=2
SCRAPE_QUEUE_SIZE=100
MAX_IMAGE_BYTES=20971520
JOB_RETENTION_DAYS=7
LOG_RETENTION_DAYS=7
API_LOG_QUEUE_SIZE=5000
API_LOG_BATCH_SIZE=100
