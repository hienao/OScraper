APP_ENV=production
# Generate, for example: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
# Provide exactly 32 random bytes or a base64-encoded 32-byte value.
CREDENTIAL_ENCRYPTION_KEY=00000000000000000000000000000000
TZ=Asia/Shanghai
# Run the application as the host user/group that owns local media.
PUID=1000
PGID=1000
UMASK=002
HOST_DATA_DIR=./runtime/data
HOST_CACHE_DIR=./runtime/cache
# Host directory exposed to local scrape targets as /media.
HOST_MEDIA_DIR=./runtime/media
SCRAPE_WORKERS=2
SCRAPE_QUEUE_SIZE=100
# Directory scans use a separate bounded read-only worker pool.
SCAN_WORKERS=1
SCAN_QUEUE_SIZE=20
MAX_IMAGE_BYTES=20971520
JOB_RETENTION_DAYS=7
LOG_RETENTION_DAYS=7
# Terminal jobs, expired previews, unreferenced candidates and scans.
DATA_RETENTION_DAYS=30
API_LOG_QUEUE_SIZE=5000
API_LOG_BATCH_SIZE=100
